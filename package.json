{
  "name": "nexus-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal MCP server exposing local filesystem and shell tools to web AI clients",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run build && npm run test && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
