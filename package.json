{
  "name": "nexus-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal MCP server exposing local filesystem and shell tools to web AI clients",
  "main": "dist/index.js",
  "scripts": {
    "build:executor": "cargo build --release --manifest-path crates/executor/Cargo.toml",
    "build:tray": "cargo build --release --manifest-path crates/tray/Cargo.toml",
    "build": "npm run build:executor && npm run build:tray && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build:executor && vitest run --pool=vmThreads",
    "test:rs": "cargo test --manifest-path crates/Cargo.toml",
    "smoke": "tsx scripts/smoke.ts",
    "package:stage": "npm run build && tsx scripts/package.ts --stage-only",
    "package": "npm run build && tsx scripts/package.ts",
    "package:smoke": "tsx scripts/smoke-package.ts",
    "check": "npm run build && npm run test && npm run test:rs && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
